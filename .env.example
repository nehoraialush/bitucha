# Replace placeholders locally; never commit .env. Use URL-safe passwords (hex recommended).
DB_PASSWORD=replace_with_random_database_password
ADMIN_EMAIL=admin@bitucha.local
ADMIN_PASSWORD=replace_with_random_admin_password_16_chars_minimum
# Optional: adds service, underwriter, claims, finance and auditor demo employees.
DEMO_PASSWORD=
# Local development (outside Docker): adapt to your database.
DATABASE_URL=postgresql://bitucha:replace_with_random_database_password@127.0.0.1:5432/bitucha
WEB_ORIGIN=http://localhost:5173
DOCKER_WEB_ORIGIN=http://localhost:8080
CHROMIUM_PATH=/usr/bin/chromium
CHROMIUM_NO_SANDBOX=true
